{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spytify",
  "version": "0.1.2",
  "identifier": "com.spytify.music",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Spytify",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": true,
        "transparent": false,
        "additionalBrowserArgs": "--disable-features=Translate,OptimizationHints,MediaRouter,CalculateNativeWinOcclusion --disk-cache-size=16777216 --media-cache-size=16777216 --js-flags=--max-old-space-size=96 --renderer-process-limit=1 --enable-low-end-device-mode --disable-gpu-shader-disk-cache --disable-background-networking --disable-component-update --disable-default-apps --disable-extensions --disable-sync"
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
